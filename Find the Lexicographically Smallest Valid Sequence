#include <stdlib.h>
#include <string.h>

int* validSequence(char* word1, char* word2, int* returnSize) {
    int len1 = strlen(word1);
    int len2 = strlen(word2);
    
    int* last_match = (int*)malloc((len1 + 1) * sizeof(int));
    last_match[len1] = 0;
    
    int j = len2 - 1;
    for (int i = len1 - 1; i >= 0; i--) {
        if (j >= 0 && word1[i] == word2[j]) {
            j--;
        }
        last_match[i] = len2 - 1 - j;
    }
    
    int* result = (int*)malloc(len2 * sizeof(int));
    int res_idx = 0;
    int changed = 0;
    j = 0;
    
    for (int i = 0; i < len1 && j < len2; i++) {
        if (word1[i] == word2[j]) {
            result[res_idx++] = i;
            j++;
        } else if (!changed && last_match[i + 1] >= (len2 - j - 1)) {
            result[res_idx++] = i;
            j++;
            changed = 1;
        }
    }
    
    free(last_match);
    
    if (res_idx == len2) {
        *returnSize = len2;
        return result;
    }
    
    free(result);
    *returnSize = 0;
    return NULL;
}
